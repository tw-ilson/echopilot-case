// EchoPilot AI + Carrier full-stack snap-fit case, Jetson Orin NX with open heatsink window.
// Generated by tools/gen_kcl.py from EchoMAV ECHOPILOT_FULL_STACK.step (frame: board centre = origin).
// Print: bottom shell as-is, top shell flipped (lid on bed). PLA, 0.4 nozzle.
// Assembly: stack rests on its own bottom posts (screw heads on the floor); cups around each post locate it.
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

fn box(x0, y0, z0, x1, y1, z1) {
  return startSketchOn(offsetPlane(XY, offset = z0))
    |> rectangle(corner = [x0, y0], width = x1 - x0, height = y1 - y0)
    |> extrude(length = z1 - z0)
}

fn cyl(cx, cy, z0, z1, r) {
  return startSketchOn(offsetPlane(XY, offset = z0))
    |> circle(center = [cx, cy], radius = r)
    |> extrude(length = z1 - z0)
}

fn rect(z, hx, hy) {
  return startSketchOn(offsetPlane(XY, offset = z))
    |> rectangle(corner = [-hx, -hy], width = 2 * hx, height = 2 * hy)
}

wall = 2.0
split = 29.3

// ---------- bottom shell ----------

// ---------- top shell ----------
tOuter = box(x0 = -46.00, y0 = -34.00, z0 = 29.60, x1 = 46.00, y1 = 34.00, z1 = 45.00)
tCav = box(x0 = -44.00, y0 = -32.00, z0 = 28.30, x1 = 44.00, y1 = 32.00, z1 = 43.00)
tShell = subtract(tOuter, tools = [tCav])
tBody = tShell

// ---------- cuts ----------
grooveP0 = startSketchOn(offsetPlane(YZ, offset = -43.20))
groove0 = startProfile(grooveP0, at = [-31.00, 34.09]) |> line(endAbsolute = [-32.70, 31.80]) |> line(endAbsolute = [-32.70, 31.20]) |> line(endAbsolute = [-31.00, 31.20]) |> close() |> extrude(length = 8.35)
grooveP1 = startSketchOn(offsetPlane(YZ, offset = 13.86))
groove1 = startProfile(grooveP1, at = [-31.00, 34.09]) |> line(endAbsolute = [-32.70, 31.80]) |> line(endAbsolute = [-32.70, 31.20]) |> line(endAbsolute = [-31.00, 31.20]) |> close() |> extrude(length = 10.70)
grooveP2 = startSketchOn(offsetPlane(YZ, offset = 35.01))
groove2 = startProfile(grooveP2, at = [-31.00, 34.09]) |> line(endAbsolute = [-32.70, 31.80]) |> line(endAbsolute = [-32.70, 31.20]) |> line(endAbsolute = [-31.00, 31.20]) |> close() |> extrude(length = 8.19)
grooveP3 = startSketchOn(offsetPlane(YZ, offset = -43.04))
groove3 = startProfile(grooveP3, at = [31.00, 31.20]) |> line(endAbsolute = [32.70, 31.20]) |> line(endAbsolute = [32.70, 31.80]) |> line(endAbsolute = [31.00, 34.09]) |> close() |> extrude(length = 12.20)
grooveP4 = startSketchOn(offsetPlane(YZ, offset = 0.80))
groove4 = startProfile(grooveP4, at = [31.00, 31.20]) |> line(endAbsolute = [32.70, 31.20]) |> line(endAbsolute = [32.70, 31.80]) |> line(endAbsolute = [31.00, 34.09]) |> close() |> extrude(length = 10.20)
grooveP5 = startSketchOn(offsetPlane(YZ, offset = 16.90))
groove5 = startProfile(grooveP5, at = [31.00, 31.20]) |> line(endAbsolute = [32.70, 31.20]) |> line(endAbsolute = [32.70, 31.80]) |> line(endAbsolute = [31.00, 34.09]) |> close() |> extrude(length = 10.20)
grooveP6 = startSketchOn(offsetPlane(YZ, offset = 33.00))
groove6 = startProfile(grooveP6, at = [31.00, 31.20]) |> line(endAbsolute = [32.70, 31.20]) |> line(endAbsolute = [32.70, 31.80]) |> line(endAbsolute = [31.00, 34.09]) |> close() |> extrude(length = 10.20)
window = box(x0 = -30.40, y0 = -30.00, z0 = 42.00, x1 = 30.40, y1 = 13.00, z1 = 46.00)
fanNotch = box(x0 = 29.90, y0 = 6.00, z0 = 42.00, x1 = 32.90, y1 = 10.00, z1 = 46.00)
btn0 = cyl(cx = 5.0, cy = 27.1, z0 = 42.0, z1 = 46.0, r = 1.5)
btn1 = cyl(cx = 8.75, cy = 27.1, z0 = 42.0, z1 = 46.0, r = 1.5)

fn portTools() {
  return [box(x0 = 42.00, y0 = -24.15, z0 = 15.32, x1 = 48.00, y1 = 24.24, z1 = 41.26), box(x0 = -48.00, y0 = -24.28, z0 = 15.32, x1 = -42.00, y1 = 24.69, z1 = 30.40), box(x0 = -48.00, y0 = -21.14, z0 = 32.36, x1 = -42.00, y1 = 7.88, z1 = 40.32), box(x0 = -30.18, y0 = 30.00, z0 = 18.12, x1 = -5.06, y1 = 36.00, z1 = 30.30), box(x0 = -3.54, y0 = 30.00, z0 = 18.12, x1 = 31.74, y1 = 36.00, z1 = 22.49), box(x0 = -34.35, y0 = -36.00, z0 = 16.52, x1 = 13.36, y1 = -30.00, z1 = 30.30), box(x0 = -29.06, y0 = -36.00, z0 = 28.30, x1 = -9.29, y1 = -30.00, z1 = 39.32), box(x0 = 25.06, y0 = -36.00, z0 = 16.52, x1 = 34.51, y1 = -30.00, z1 = 30.30)]
}

topShellA = subtract(tBody, tools = portTools())
tS0 = subtract(topShellA, tools = [groove0])
tS1 = subtract(tS0, tools = [groove1])
tS2 = subtract(tS1, tools = [groove2])
tS3 = subtract(tS2, tools = [groove3])
tS4 = subtract(tS3, tools = [groove4])
tS5 = subtract(tS4, tools = [groove5])
tS6 = subtract(tS5, tools = [groove6])
tS7 = subtract(tS6, tools = [window])
tS8 = subtract(tS7, tools = [fanNotch])
tS9 = subtract(tS8, tools = [btn0])
tS10 = subtract(tS9, tools = [btn1])
topShellL = tS10
topShellB = topShellL

// Print orientation: flipped so the lid is on the bed at z = 0.
topPrint = topShellB
  |> rotate(roll = 180)
  |> translate(z = -45.00)  // translate after rotate acts in the flipped frame; offset measured from the exported STL
