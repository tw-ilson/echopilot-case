// EchoPilot AI + Carrier full-stack snap-fit case, Jetson Orin NX with open heatsink window.
// Generated by tools/gen_kcl.py from EchoMAV ECHOPILOT_FULL_STACK.step (frame: board centre = origin).
// Print: bottom shell as-is, top shell flipped (lid on bed). PLA, 0.4 nozzle.
// Assembly: stack rests on its own bottom posts (screw heads on the floor); cups around each post locate it.
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

fn box(x0, y0, z0, x1, y1, z1) {
  return startSketchOn(offsetPlane(XY, offset = z0))
    |> rectangle(corner = [x0, y0], width = x1 - x0, height = y1 - y0)
    |> extrude(length = z1 - z0)
}

fn cyl(cx, cy, z0, z1, r) {
  return startSketchOn(offsetPlane(XY, offset = z0))
    |> circle(center = [cx, cy], radius = r)
    |> extrude(length = z1 - z0)
}

fn rect(z, hx, hy) {
  return startSketchOn(offsetPlane(XY, offset = z))
    |> rectangle(corner = [-hx, -hy], width = 2 * hx, height = 2 * hy)
}

wall = 2.0
split = 29.3

// ---------- bottom shell ----------
bOuter = box(x0 = -46.00, y0 = -34.00, z0 = 11.50, x1 = 46.00, y1 = 34.00, z1 = 29.30)
bCav = box(x0 = -44.00, y0 = -32.00, z0 = 13.50, x1 = 44.00, y1 = 32.00, z1 = 30.30)
bShell = subtract(bOuter, tools = [bCav])
lipO = box(x0 = -43.70, y0 = -31.70, z0 = 27.30, x1 = 43.70, y1 = 31.70, z1 = 34.30)
lipI = box(x0 = -42.10, y0 = -30.10, z0 = 26.30, x1 = 42.10, y1 = 30.10, z1 = 35.30)
lipB = box(x0 = -44.50, y0 = -32.50, z0 = 27.30, x1 = 44.50, y1 = 32.50, z1 = 28.80)
chO = box(x0 = -44.50, y0 = -32.50, z0 = 25.20, x1 = 44.50, y1 = 32.50, z1 = 27.60)
chI = loft([rect(z = 25.19, hx = 44.20, hy = 32.20), rect(z = 27.61, hx = 41.80, hy = 29.80)])
chamfer = subtract(chO, tools = [chI])
lip0 = subtract(union([lipO, lipB, chamfer]), tools = [lipI])
lipN0 = subtract(lip0, tools = [box(x0 = -40.80, y0 = -28.90, z0 = 24.20, x1 = -35.20, y1 = -23.10, z1 = 35.30)])
lipN1 = subtract(lipN0, tools = [box(x0 = -40.80, y0 = 23.10, z0 = 24.20, x1 = -35.20, y1 = 28.90, z1 = 35.30)])
lipN2 = subtract(lipN1, tools = [box(x0 = 35.20, y0 = -28.90, z0 = 24.20, x1 = 40.80, y1 = -23.10, z1 = 35.30)])
lipN3 = subtract(lipN2, tools = [box(x0 = 35.20, y0 = 23.10, z0 = 24.20, x1 = 40.80, y1 = 28.90, z1 = 35.30)])
lipP = lipN3
lip1 = subtract(lipP, tools = [box(x0 = 41.50, y0 = -24.65, z0 = 24.20, x1 = 48.50, y1 = 24.74, z1 = 35.30)])
lip2 = subtract(lip1, tools = [box(x0 = -48.50, y0 = -24.78, z0 = 24.20, x1 = -41.50, y1 = 25.19, z1 = 35.30)])
lip3 = subtract(lip2, tools = [box(x0 = -48.50, y0 = -21.64, z0 = 24.20, x1 = -41.50, y1 = 8.38, z1 = 35.30)])
lip4 = subtract(lip3, tools = [box(x0 = -30.68, y0 = 29.50, z0 = 24.20, x1 = -4.56, y1 = 36.50, z1 = 35.30)])
lip5 = subtract(lip4, tools = [box(x0 = -34.85, y0 = -36.50, z0 = 24.20, x1 = 13.86, y1 = -29.50, z1 = 35.30)])
lip6 = subtract(lip5, tools = [box(x0 = -29.56, y0 = -36.50, z0 = 24.20, x1 = -8.79, y1 = -29.50, z1 = 35.30)])
lip7 = subtract(lip6, tools = [box(x0 = 24.56, y0 = -36.50, z0 = 24.20, x1 = 35.01, y1 = -29.50, z1 = 35.30)])
lip8 = subtract(lip7, tools = [box(x0 = -5.50, y0 = -36.50, z0 = 24.20, x1 = 0.80, y1 = 36.50, z1 = 35.30)])
lip = lip8
bumpP0 = startSketchOn(offsetPlane(YZ, offset = -43.10))
bump0 = startProfile(bumpP0, at = [-31.50, 33.27]) |> line(endAbsolute = [-32.60, 31.70]) |> line(endAbsolute = [-32.60, 31.30]) |> line(endAbsolute = [-31.50, 31.30]) |> close() |> extrude(length = 8.15)
bumpP1 = startSketchOn(offsetPlane(YZ, offset = 13.96))
bump1 = startProfile(bumpP1, at = [-31.50, 33.27]) |> line(endAbsolute = [-32.60, 31.70]) |> line(endAbsolute = [-32.60, 31.30]) |> line(endAbsolute = [-31.50, 31.30]) |> close() |> extrude(length = 10.50)
bumpP2 = startSketchOn(offsetPlane(YZ, offset = 35.11))
bump2 = startProfile(bumpP2, at = [-31.50, 33.27]) |> line(endAbsolute = [-32.60, 31.70]) |> line(endAbsolute = [-32.60, 31.30]) |> line(endAbsolute = [-31.50, 31.30]) |> close() |> extrude(length = 7.99)
bumpP3 = startSketchOn(offsetPlane(YZ, offset = -42.94))
bump3 = startProfile(bumpP3, at = [31.50, 31.30]) |> line(endAbsolute = [32.60, 31.30]) |> line(endAbsolute = [32.60, 31.70]) |> line(endAbsolute = [31.50, 33.27]) |> close() |> extrude(length = 12.00)
bumpP4 = startSketchOn(offsetPlane(YZ, offset = 0.90))
bump4 = startProfile(bumpP4, at = [31.50, 31.30]) |> line(endAbsolute = [32.60, 31.30]) |> line(endAbsolute = [32.60, 31.70]) |> line(endAbsolute = [31.50, 33.27]) |> close() |> extrude(length = 10.00)
bumpP5 = startSketchOn(offsetPlane(YZ, offset = 17.00))
bump5 = startProfile(bumpP5, at = [31.50, 31.30]) |> line(endAbsolute = [32.60, 31.30]) |> line(endAbsolute = [32.60, 31.70]) |> line(endAbsolute = [31.50, 33.27]) |> close() |> extrude(length = 10.00)
bumpP6 = startSketchOn(offsetPlane(YZ, offset = 33.10))
bump6 = startProfile(bumpP6, at = [31.50, 31.30]) |> line(endAbsolute = [32.60, 31.30]) |> line(endAbsolute = [32.60, 31.70]) |> line(endAbsolute = [31.50, 33.27]) |> close() |> extrude(length = 10.00)
bU0 = union([bShell, lip])
bBody = union([bU0, bump0, bump1, bump2, bump3, bump4, bump5, bump6])

// ---------- top shell ----------

// ---------- cuts ----------

fn portTools() {
  return [box(x0 = 42.00, y0 = -24.15, z0 = 15.32, x1 = 48.00, y1 = 24.24, z1 = 41.26), box(x0 = -48.00, y0 = -24.28, z0 = 15.32, x1 = -42.00, y1 = 24.69, z1 = 30.40), box(x0 = -48.00, y0 = -21.14, z0 = 32.36, x1 = -42.00, y1 = 7.88, z1 = 40.32), box(x0 = -30.18, y0 = 30.00, z0 = 18.12, x1 = -5.06, y1 = 36.00, z1 = 30.30), box(x0 = -3.54, y0 = 30.00, z0 = 18.12, x1 = 31.74, y1 = 36.00, z1 = 22.49), box(x0 = -34.35, y0 = -36.00, z0 = 16.52, x1 = 13.36, y1 = -30.00, z1 = 30.30), box(x0 = -29.06, y0 = -36.00, z0 = 28.30, x1 = -9.29, y1 = -30.00, z1 = 39.32), box(x0 = 25.06, y0 = -36.00, z0 = 16.52, x1 = 34.51, y1 = -30.00, z1 = 30.30)]
}

bottomShellA0 = subtract(bBody, tools = portTools())
bN0 = subtract(bottomShellA0, tools = [box(x0 = 40.60, y0 = -22.60, z0 = 10.50, x1 = 48.00, y1 = 22.60, z1 = 23.57)])
bN1 = subtract(bN0, tools = [box(x0 = -48.00, y0 = -22.60, z0 = 10.50, x1 = -40.60, y1 = 20.68, z1 = 23.57)])
bottomShellA = bN1
bottomShellS = bottomShellA
bH0 = subtract(bottomShellS, tools = [cyl(cx = -38.0, cy = -26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bH1 = subtract(bH0, tools = [cyl(cx = -38.0, cy = 26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bH2 = subtract(bH1, tools = [cyl(cx = 38.0, cy = -26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bH3 = subtract(bH2, tools = [cyl(cx = 38.0, cy = 26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bottomShellH = bH3
bottomShell = bottomShellH

// Print orientation: floor on the bed at z = 0.
bottomPrint = bottomShell |> translate(z = -11.50)
