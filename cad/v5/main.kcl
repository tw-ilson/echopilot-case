// EchoPilot AI + Carrier full-stack snap-fit case, Jetson Orin NX with open heatsink window.
// Generated by tools/gen_kcl.py from EchoMAV ECHOPILOT_FULL_STACK.step (frame: board centre = origin).
// Print: bottom shell as-is, top shell flipped (lid on bed). PLA, 0.4 nozzle.
// Assembly: stack rests on its own bottom posts (screw heads on the floor); cups around each post locate it.
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

fn box(x0, y0, z0, x1, y1, z1) {
  return startSketchOn(offsetPlane(XY, offset = z0))
    |> rectangle(corner = [x0, y0], width = x1 - x0, height = y1 - y0)
    |> extrude(length = z1 - z0)
}

fn cyl(cx, cy, z0, z1, r) {
  return startSketchOn(offsetPlane(XY, offset = z0))
    |> circle(center = [cx, cy], radius = r)
    |> extrude(length = z1 - z0)
}

fn rect(z, hx, hy) {
  return startSketchOn(offsetPlane(XY, offset = z))
    |> rectangle(corner = [-hx, -hy], width = 2 * hx, height = 2 * hy)
}

wall = 2.0
split = 29.3

// ---------- bottom shell ----------
bOuter = box(x0 = -46.00, y0 = -34.00, z0 = 11.50, x1 = 46.00, y1 = 34.00, z1 = 29.30)
bCav = box(x0 = -44.00, y0 = -32.00, z0 = 13.50, x1 = 44.00, y1 = 32.00, z1 = 30.30)
bShell = subtract(bOuter, tools = [bCav])
lipO = box(x0 = -43.70, y0 = -31.70, z0 = 27.30, x1 = 43.70, y1 = 31.70, z1 = 32.30)
lipI = box(x0 = -42.10, y0 = -30.10, z0 = 26.30, x1 = 42.10, y1 = 30.10, z1 = 33.30)
lipB = box(x0 = -44.50, y0 = -32.50, z0 = 27.30, x1 = 44.50, y1 = 32.50, z1 = 28.80)
chO = box(x0 = -44.50, y0 = -32.50, z0 = 25.20, x1 = 44.50, y1 = 32.50, z1 = 27.60)
chI = loft([rect(z = 25.19, hx = 44.20, hy = 32.20), rect(z = 27.61, hx = 41.80, hy = 29.80)])
chamfer = subtract(chO, tools = [chI])
lip0 = subtract(union([lipO, lipB, chamfer]), tools = [lipI])
lipN0 = subtract(lip0, tools = [box(x0 = -40.80, y0 = -28.90, z0 = 24.20, x1 = -35.20, y1 = -23.10, z1 = 33.30)])
lipN1 = subtract(lipN0, tools = [box(x0 = -40.80, y0 = 23.10, z0 = 24.20, x1 = -35.20, y1 = 28.90, z1 = 33.30)])
lipN2 = subtract(lipN1, tools = [box(x0 = 35.20, y0 = -28.90, z0 = 24.20, x1 = 40.80, y1 = -23.10, z1 = 33.30)])
lipN3 = subtract(lipN2, tools = [box(x0 = 35.20, y0 = 23.10, z0 = 24.20, x1 = 40.80, y1 = 28.90, z1 = 33.30)])
lipP = lipN3
lip1 = subtract(lipP, tools = [box(x0 = 41.80, y0 = -23.35, z0 = 24.20, x1 = 48.20, y1 = 23.44, z1 = 33.30)])
lip2 = subtract(lip1, tools = [box(x0 = 41.80, y0 = 12.45, z0 = 24.20, x1 = 48.20, y1 = 21.60, z1 = 33.30)])
lip3 = subtract(lip2, tools = [box(x0 = 41.80, y0 = -8.20, z0 = 24.20, x1 = 48.20, y1 = 2.21, z1 = 33.30)])
lip4 = subtract(lip3, tools = [box(x0 = -48.20, y0 = -23.48, z0 = 24.20, x1 = -41.80, y1 = 23.89, z1 = 33.30)])
lip5 = subtract(lip4, tools = [box(x0 = -48.20, y0 = -20.34, z0 = 24.20, x1 = -41.80, y1 = 7.08, z1 = 33.30)])
lip6 = subtract(lip5, tools = [box(x0 = -30.78, y0 = 29.80, z0 = 24.20, x1 = 32.34, y1 = 36.20, z1 = 33.30)])
lip7 = subtract(lip6, tools = [box(x0 = -34.95, y0 = -36.20, z0 = 24.20, x1 = 13.96, y1 = -29.80, z1 = 33.30)])
lip8 = subtract(lip7, tools = [box(x0 = -29.66, y0 = -36.20, z0 = 24.20, x1 = -8.69, y1 = -29.80, z1 = 33.30)])
lip9 = subtract(lip8, tools = [box(x0 = 24.46, y0 = -36.20, z0 = 24.20, x1 = 35.11, y1 = -29.80, z1 = 33.30)])
lip = lip9
bump0 = box(x0 = -40.00, y0 = -32.30, z0 = 30.50, x1 = -35.00, y1 = -31.50, z1 = 31.50)
bump1 = box(x0 = 35.00, y0 = -32.30, z0 = 30.50, x1 = 40.00, y1 = -31.50, z1 = 31.50)
bump2 = box(x0 = -40.00, y0 = 31.50, z0 = 30.50, x1 = -35.00, y1 = 32.30, z1 = 31.50)
bump3 = box(x0 = 35.00, y0 = 31.50, z0 = 30.50, x1 = 40.00, y1 = 32.30, z1 = 31.50)
bU0 = union([bShell, lip])
bU1 = union([bU0, bump0])
bU2 = union([bU1, bump1])
bU3 = union([bU2, bump2])
bU4 = union([bU3, bump3])
bBody = bU4

// ---------- top shell ----------
tOuter = box(x0 = -46.00, y0 = -34.00, z0 = 29.60, x1 = 46.00, y1 = 34.00, z1 = 46.50)
tCav = box(x0 = -44.00, y0 = -32.00, z0 = 28.30, x1 = 44.00, y1 = 32.00, z1 = 44.50)
tShell = subtract(tOuter, tools = [tCav])
tBody = tShell

// ---------- cuts ----------
groove0 = box(x0 = -40.30, y0 = -32.60, z0 = 30.20, x1 = -34.70, y1 = -31.20, z1 = 31.80)
groove1 = box(x0 = 34.70, y0 = -32.60, z0 = 30.20, x1 = 40.30, y1 = -31.20, z1 = 31.80)
groove2 = box(x0 = -40.30, y0 = 31.20, z0 = 30.20, x1 = -34.70, y1 = 32.60, z1 = 31.80)
groove3 = box(x0 = 34.70, y0 = 31.20, z0 = 30.20, x1 = 40.30, y1 = 32.60, z1 = 31.80)
window = box(x0 = -30.40, y0 = -30.00, z0 = 43.50, x1 = 30.40, y1 = 13.00, z1 = 47.50)
btn0 = cyl(cx = 5.0, cy = 27.1, z0 = 43.5, z1 = 47.5, r = 1.5)
btn1 = cyl(cx = 8.75, cy = 27.1, z0 = 43.5, z1 = 47.5, r = 1.5)

fn portTools() {
  return [box(x0 = 42.00, y0 = -23.15, z0 = 16.32, x1 = 48.00, y1 = 23.24, z1 = 30.30), box(x0 = 42.00, y0 = 12.65, z0 = 28.30, x1 = 48.00, y1 = 21.40, z1 = 40.76), box(x0 = 42.00, y0 = -8.00, z0 = 28.30, x1 = 48.00, y1 = 2.01, z1 = 36.61), box(x0 = -48.00, y0 = -23.28, z0 = 16.32, x1 = -42.00, y1 = 23.69, z1 = 30.30), box(x0 = -48.00, y0 = -20.14, z0 = 33.36, x1 = -42.00, y1 = 6.88, z1 = 39.82), box(x0 = -30.58, y0 = 30.00, z0 = 17.92, x1 = 32.14, y1 = 36.00, z1 = 30.30), box(x0 = -34.75, y0 = -36.00, z0 = 16.32, x1 = 13.76, y1 = -30.00, z1 = 30.30), box(x0 = -29.46, y0 = -36.00, z0 = 28.30, x1 = -8.89, y1 = -30.00, z1 = 39.82), box(x0 = 24.66, y0 = -36.00, z0 = 16.32, x1 = 34.91, y1 = -30.00, z1 = 30.30)]
}

bottomShellA = subtract(bBody, tools = portTools())
bottomShellS = bottomShellA
bH0 = subtract(bottomShellS, tools = [cyl(cx = -38.0, cy = -26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bH1 = subtract(bH0, tools = [cyl(cx = -38.0, cy = 26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bH2 = subtract(bH1, tools = [cyl(cx = 38.0, cy = -26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bH3 = subtract(bH2, tools = [cyl(cx = 38.0, cy = 26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bottomShellH = bH3
bottomShell = bottomShellH
topShellA = subtract(tBody, tools = portTools())
tHole0 = cyl(cx = -38.0, cy = -26.0, z0 = 43.50, z1 = 47.50, r = 3.25)
tHole1 = cyl(cx = -38.0, cy = 26.0, z0 = 43.50, z1 = 47.50, r = 3.25)
tHole2 = cyl(cx = 38.0, cy = -26.0, z0 = 43.50, z1 = 47.50, r = 3.25)
tHole3 = cyl(cx = 38.0, cy = 26.0, z0 = 43.50, z1 = 47.50, r = 3.25)
tS0 = subtract(topShellA, tools = [groove0])
tS1 = subtract(tS0, tools = [groove1])
tS2 = subtract(tS1, tools = [groove2])
tS3 = subtract(tS2, tools = [groove3])
tS4 = subtract(tS3, tools = [window])
tS5 = subtract(tS4, tools = [btn0])
tS6 = subtract(tS5, tools = [btn1])
tS7 = subtract(tS6, tools = [tHole0])
tS8 = subtract(tS7, tools = [tHole1])
tS9 = subtract(tS8, tools = [tHole2])
tS10 = subtract(tS9, tools = [tHole3])
topShellL = tS10
topShellB = topShellL

// Assembly view: top shell exploded 15 mm above (set explode = 0 for the assembled position).
explode = 15
topShell = topShellB |> translate(z = explode)
