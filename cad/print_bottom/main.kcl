lip7 = subtract(lip6, tools = [box(x0 = -34.95, y0 = -34.20, z0 = 24.20, x1 = 13.96, y1 = -27.80, z1 = 33.30)])
lip8 = subtract(lip7, tools = [box(x0 = -29.66, y0 = -34.20, z0 = 24.20, x1 = -8.69, y1 = -27.80, z1 = 33.30)])
