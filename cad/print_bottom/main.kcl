lipO = box(x0 = -42.20, y0 = -29.70, z0 = 27.30, x1 = 42.20, y1 = 29.70, z1 = 32.30)
lipI = box(x0 = -40.60, y0 = -28.10, z0 = 26.30, x1 = 40.60, y1 = 28.10, z1 = 33.30)
