  return [box(x0 = 40.50, y0 = -23.15, z0 = 16.32, x1 = 46.50, y1 = 23.24, z1 = 30.30), box(x0 = 40.50, y0 = 12.65, z0 = 28.30, x1 = 46.50, y1 = 21.40, z1 = 40.76), box(x0 = 40.50, y0 = -8.00, z0 = 28.30, x1 = 46.50, y1 = 2.01, z1 = 36.61), box(x0 = -46.50, y0 = -23.28, z0 = 16.32, x1 = -40.50, y1 = 23.69, z1 = 30.30), box(x0 = -46.50, y0 = -20.14, z0 = 33.36, x1 = -40.50, y1 = 6.88, z1 = 39.82), box(x0 = -30.58, y0 = 28.00, z0 = 17.92, x1 = 32.14, y1 = 34.00, z1 = 30.30), box(x0 = -34.75, y0 = -34.00, z0 = 16.32, x1 = 13.76, y1 = -28.00, z1 = 30.30), box(x0 = -29.46, y0 = -34.00, z0 = 28.30, x1 = -8.89, y1 = -28.00, z1 = 39.82), box(x0 = 24.66, y0 = -34.00, z0 = 16.32, x1 = 34.91, y1 = -28.00, z1 = 30.30)]
}

