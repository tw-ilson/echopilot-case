bump2 = box(x0 = -40.00, y0 = 29.50, z0 = 30.50, x1 = -35.00, y1 = 30.30, z1 = 31.50)
bump3 = box(x0 = 35.00, y0 = 29.50, z0 = 30.50, x1 = 40.00, y1 = 30.30, z1 = 31.50)
bU0 = union([bShell, lip])
bU1 = union([bU0, bump0])
bU2 = union([bU1, bump1])
bU3 = union([bU2, bump2])
bU4 = union([bU3, bump3])
bBody = bU4

