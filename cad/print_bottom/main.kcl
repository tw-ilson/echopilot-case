lipP = lipN3
lip1 = subtract(lipP, tools = [box(x0 = 40.30, y0 = -23.35, z0 = 24.20, x1 = 46.70, y1 = 23.44, z1 = 33.30)])
lip2 = subtract(lip1, tools = [box(x0 = 40.30, y0 = 12.45, z0 = 24.20, x1 = 46.70, y1 = 21.60, z1 = 33.30)])
