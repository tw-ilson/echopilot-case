// EchoPilot AI + Carrier full-stack snap-fit case, Jetson Orin NX with open heatsink window.
// Generated by tools/gen_kcl.py from EchoMAV ECHOPILOT_FULL_STACK.step (frame: board centre = origin).
// Print: bottom shell as-is, top shell flipped (lid on bed). PLA, 0.4 nozzle.
// Assembly: stack rests on its own bottom posts (screw heads on the floor); cups around each post locate it.
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

fn box(x0, y0, z0, x1, y1, z1) {
  return startSketchOn(offsetPlane(XY, offset = z0))
    |> rectangle(corner = [x0, y0], width = x1 - x0, height = y1 - y0)
    |> extrude(length = z1 - z0)
}

fn cyl(cx, cy, z0, z1, r) {
  return startSketchOn(offsetPlane(XY, offset = z0))
    |> circle(center = [cx, cy], radius = r)
    |> extrude(length = z1 - z0)
}

fn rect(z, hx, hy) {
  return startSketchOn(offsetPlane(XY, offset = z))
    |> rectangle(corner = [-hx, -hy], width = 2 * hx, height = 2 * hy)
}

wall = 2.0
split = 29.3

// ---------- bottom shell ----------
bOuter = box(x0 = -46.00, y0 = -34.00, z0 = 11.50, x1 = 46.00, y1 = 34.00, z1 = 29.30)
bCav = box(x0 = -44.00, y0 = -32.00, z0 = 13.50, x1 = 44.00, y1 = 32.00, z1 = 30.30)
bShell = subtract(bOuter, tools = [bCav])
lipO = box(x0 = -43.70, y0 = -31.70, z0 = 27.30, x1 = 43.70, y1 = 31.70, z1 = 32.30)
lipI = box(x0 = -42.10, y0 = -30.10, z0 = 26.30, x1 = 42.10, y1 = 30.10, z1 = 33.30)
lipB = box(x0 = -44.50, y0 = -32.50, z0 = 27.30, x1 = 44.50, y1 = 32.50, z1 = 28.80)
chO = box(x0 = -44.50, y0 = -32.50, z0 = 25.20, x1 = 44.50, y1 = 32.50, z1 = 27.60)
chI = loft([rect(z = 25.19, hx = 44.20, hy = 32.20), rect(z = 27.61, hx = 41.80, hy = 29.80)])
chamfer = subtract(chO, tools = [chI])
lip0 = subtract(union([lipO, lipB, chamfer]), tools = [lipI])
lipN0 = subtract(lip0, tools = [box(x0 = -40.80, y0 = -28.90, z0 = 24.20, x1 = -35.20, y1 = -23.10, z1 = 33.30)])
lipN1 = subtract(lipN0, tools = [box(x0 = -40.80, y0 = 23.10, z0 = 24.20, x1 = -35.20, y1 = 28.90, z1 = 33.30)])
lipN2 = subtract(lipN1, tools = [box(x0 = 35.20, y0 = -28.90, z0 = 24.20, x1 = 40.80, y1 = -23.10, z1 = 33.30)])
lipN3 = subtract(lipN2, tools = [box(x0 = 35.20, y0 = 23.10, z0 = 24.20, x1 = 40.80, y1 = 28.90, z1 = 33.30)])
lipP = lipN3
lip1 = subtract(lipP, tools = [box(x0 = 41.80, y0 = -24.35, z0 = 24.20, x1 = 48.20, y1 = 24.44, z1 = 33.30)])
lip2 = subtract(lip1, tools = [box(x0 = -48.20, y0 = -24.48, z0 = 24.20, x1 = -41.80, y1 = 24.89, z1 = 33.30)])
lip3 = subtract(lip2, tools = [box(x0 = -48.20, y0 = -21.34, z0 = 24.20, x1 = -41.80, y1 = 8.08, z1 = 33.30)])
lip4 = subtract(lip3, tools = [box(x0 = -31.78, y0 = 29.80, z0 = 24.20, x1 = 33.34, y1 = 36.20, z1 = 33.30)])
lip5 = subtract(lip4, tools = [box(x0 = -35.95, y0 = -36.20, z0 = 24.20, x1 = 14.96, y1 = -29.80, z1 = 33.30)])
lip6 = subtract(lip5, tools = [box(x0 = 23.46, y0 = -36.20, z0 = 24.20, x1 = 36.11, y1 = -29.80, z1 = 33.30)])
lip = lip6
bumpP0 = startSketchOn(offsetPlane(YZ, offset = -43.40))
bump0 = startProfile(bumpP0, at = [-31.50, 32.07]) |> line(endAbsolute = [-32.60, 30.50]) |> line(endAbsolute = [-32.60, 30.10]) |> line(endAbsolute = [-31.50, 30.10]) |> close() |> extrude(length = 7.05)
bumpP1 = startSketchOn(offsetPlane(YZ, offset = 36.51))
bump1 = startProfile(bumpP1, at = [-31.50, 32.07]) |> line(endAbsolute = [-32.60, 30.50]) |> line(endAbsolute = [-32.60, 30.10]) |> line(endAbsolute = [-31.50, 30.10]) |> close() |> extrude(length = 6.89)
bumpP2 = startSketchOn(offsetPlane(YZ, offset = -43.40))
bump2 = startProfile(bumpP2, at = [31.50, 30.10]) |> line(endAbsolute = [32.60, 30.10]) |> line(endAbsolute = [32.60, 30.50]) |> line(endAbsolute = [31.50, 32.07]) |> close() |> extrude(length = 11.22)
bumpP3 = startSketchOn(offsetPlane(YZ, offset = 33.74))
bump3 = startProfile(bumpP3, at = [31.50, 30.10]) |> line(endAbsolute = [32.60, 30.10]) |> line(endAbsolute = [32.60, 30.50]) |> line(endAbsolute = [31.50, 32.07]) |> close() |> extrude(length = 9.66)
bU0 = union([bShell, lip])
bU1 = union([bU0, bump0])
bU2 = union([bU1, bump1])
bU3 = union([bU2, bump2])
bU4 = union([bU3, bump3])
bBody = bU4

// ---------- top shell ----------
tOuter = box(x0 = -46.00, y0 = -34.00, z0 = 29.60, x1 = 46.00, y1 = 34.00, z1 = 45.00)
tCav = box(x0 = -44.00, y0 = -32.00, z0 = 28.30, x1 = 44.00, y1 = 32.00, z1 = 43.00)
tShell = subtract(tOuter, tools = [tCav])
tBody = tShell

// ---------- cuts ----------
groove0 = box(x0 = -43.70, y0 = -32.90, z0 = 29.80, x1 = -36.05, y1 = -31.20, z1 = 32.37)
groove1 = box(x0 = 36.21, y0 = -32.90, z0 = 29.80, x1 = 43.70, y1 = -31.20, z1 = 32.37)
groove2 = box(x0 = -43.70, y0 = 31.20, z0 = 29.80, x1 = -31.88, y1 = 32.90, z1 = 32.37)
groove3 = box(x0 = 33.44, y0 = 31.20, z0 = 29.80, x1 = 43.70, y1 = 32.90, z1 = 32.37)
window = box(x0 = -30.40, y0 = -30.00, z0 = 42.00, x1 = 30.40, y1 = 13.00, z1 = 46.00)
fanNotch = box(x0 = 29.90, y0 = 6.00, z0 = 42.00, x1 = 32.90, y1 = 10.00, z1 = 46.00)
btn0 = cyl(cx = 5.0, cy = 27.1, z0 = 42.0, z1 = 46.0, r = 1.5)
btn1 = cyl(cx = 8.75, cy = 27.1, z0 = 42.0, z1 = 46.0, r = 1.5)

fn portTools() {
  return [box(x0 = 42.00, y0 = -24.15, z0 = 15.32, x1 = 48.00, y1 = 24.24, z1 = 41.26), box(x0 = -48.00, y0 = -24.28, z0 = 15.32, x1 = -42.00, y1 = 24.69, z1 = 30.40), box(x0 = -48.00, y0 = -21.14, z0 = 32.36, x1 = -42.00, y1 = 7.88, z1 = 40.32), box(x0 = -31.58, y0 = 30.00, z0 = 16.92, x1 = 33.14, y1 = 36.00, z1 = 30.30), box(x0 = -35.75, y0 = -36.00, z0 = 15.32, x1 = 14.76, y1 = -30.00, z1 = 40.32), box(x0 = 23.66, y0 = -36.00, z0 = 15.32, x1 = 35.91, y1 = -30.00, z1 = 30.30)]
}

bottomShellA0 = subtract(bBody, tools = portTools())
bR0 = subtract(bottomShellA0, tools = [box(x0 = 44.80, y0 = -26.65, z0 = 13.50, x1 = 48.00, y1 = 26.74, z1 = 29.80)])
bR1 = subtract(bR0, tools = [box(x0 = -48.00, y0 = -26.78, z0 = 13.50, x1 = -44.80, y1 = 27.19, z1 = 29.80)])
bR2 = subtract(bR1, tools = [box(x0 = -48.00, y0 = -23.64, z0 = 29.86, x1 = -44.80, y1 = 10.38, z1 = 29.80)])
bR3 = subtract(bR2, tools = [box(x0 = -34.08, y0 = 32.80, z0 = 14.42, x1 = 35.64, y1 = 36.00, z1 = 29.80)])
bR4 = subtract(bR3, tools = [box(x0 = -38.25, y0 = -36.00, z0 = 13.50, x1 = 17.26, y1 = -32.80, z1 = 29.80)])
bR5 = subtract(bR4, tools = [box(x0 = 21.16, y0 = -36.00, z0 = 13.50, x1 = 38.41, y1 = -32.80, z1 = 29.80)])
bottomShellA = bR5
bottomShellS = bottomShellA
bH0 = subtract(bottomShellS, tools = [cyl(cx = -38.0, cy = -26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bH1 = subtract(bH0, tools = [cyl(cx = -38.0, cy = 26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bH2 = subtract(bH1, tools = [cyl(cx = 38.0, cy = -26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bH3 = subtract(bH2, tools = [cyl(cx = 38.0, cy = 26.0, z0 = 10.50, z1 = 14.50, r = 3.25)])
bottomShellH = bH3
bottomShell = bottomShellH
topShellA = subtract(tBody, tools = portTools())
tS0 = subtract(topShellA, tools = [groove0])
tS1 = subtract(tS0, tools = [groove1])
tS2 = subtract(tS1, tools = [groove2])
tS3 = subtract(tS2, tools = [groove3])
tS4 = subtract(tS3, tools = [window])
tS5 = subtract(tS4, tools = [fanNotch])
tS6 = subtract(tS5, tools = [btn0])
tS7 = subtract(tS6, tools = [btn1])
topShellL = tS7
topShellB = topShellL

// Assembly view: top shell exploded 15 mm above (set explode = 0 for the assembled position).
explode = 15
topShell = topShellB |> translate(z = explode)
